# 복사해서 .env 로 쓰거나, 실행할 때 환경변수로 넘긴다. 비밀값은 넣지 않는다.

# STT 엔진: mock | qwen3-asr
STT_ENGINE=mock
# TTS 엔진: mock | qwen3-tts
TTS_ENGINE=mock
# 답 찾기: family-demo (가족 돌봄 대화 시험, 기본) | fixed (예전 고정 답)
ANSWER_PROVIDER=family-demo

# 모델 id (Hugging Face). 처음 호출할 때만 불러온다.
ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_SPEAKER=Sohee
SPEECH_LANGUAGE=Korean

# auto | cuda:0 | mps | cpu
MODEL_DEVICE=auto
# bfloat16 | float16 | float32
MODEL_DTYPE=bfloat16

# 업로드 음성 최대 크기(MB)
MAX_UPLOAD_MB=20
