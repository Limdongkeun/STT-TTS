# 복사해서 .env 로 쓰거나, 실행할 때 환경변수로 넘긴다. 비밀값은 넣지 않는다.

# STT 엔진: mock | qwen3-asr
STT_ENGINE=mock
# TTS 엔진: prerecorded (D1~D25 로컬 WAV) | mock | qwen3-tts | qwen3-tts-107
TTS_ENGINE=prerecorded
# qwen3-tts-107 일 때: 107 시험 페이지 주소(필수), 목소리 견본 이름(app/data/voices/<이름>.json), 한 문장 제한 시간(초)
# TTS_107_URL=http://<107 주소>:5110
# TTS_107_VOICE=g
# TTS_107_TIMEOUT_SEC=90
# 그때그때 만드는 TTS(107·맥 Qwen)가 시험 답을 입말 문장으로 읽기: on(기본) | off
# SPOKEN_ANSWERS=on
# 답 찾기: family-demo (가족 돌봄 대화 시험, 기본) | fixed (예전 고정 답)
ANSWER_PROVIDER=family-demo

# 모델 id (Hugging Face). 처음 호출할 때만 불러온다.
ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_SPEAKER=Sohee
SPEECH_LANGUAGE=Korean

# auto | cuda:0 | mps | cpu
MODEL_DEVICE=auto
# bfloat16 | float16 | float32
MODEL_DTYPE=bfloat16

# 업로드 음성 최대 크기(MB)
MAX_UPLOAD_MB=20
