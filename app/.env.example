# 복사해서 .env 로 쓴다. 맥미니의 같은 와이파이 IP 를 넣는다 (예: ipconfig getifaddr en0).
# STT 서버: Qwen3-ASR 을 돌리는 서버 (서버 STT 모드에서만 씀)
EXPO_PUBLIC_STT_SERVER_URL=http://192.168.0.10:8001
# 답 찾기(/ask) + TTS 서버
EXPO_PUBLIC_TTS_SERVER_URL=http://192.168.0.10:8002
# 클라우드 Qwen 한국어판을 폰에서 바로 부를 때(STT '클라우드 Qwen 한국어'). 둘 다 있어야 쓰고, 없으면 맥 서버를 거친다.
# 열쇠는 앱 묶음에 들어가므로 내부 시험 앱에만 넣는다.
EXPO_PUBLIC_STT_CLOUD_URL=https://<클라우드 주소>
EXPO_PUBLIC_STT_CLOUD_KEY=<열쇠>
